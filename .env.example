# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_ENV=development           # development | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080   # Public URL — used for Cashfree notify_url

# ---------------------------------------------------------------------------
# Databases — paste any valid URL. Local, Atlas, Upstash, Neon, RDS, etc.
# ---------------------------------------------------------------------------
# postgres://user:pass@host:5432/dbname?sslmode=disable
# postgresql://user:pass@host:5432/dbname?sslmode=require
POSTGRES_URL=postgres://langex:langex_secret@localhost:5432/lang_exchange?sslmode=disable
POSTGRES_MAX_CONNS=20

# redis://localhost:6379/0
# rediss://default:TOKEN@HOST:6379   (TLS: Upstash, Redis Cloud, ElastiCache)
REDIS_URL=redis://localhost:6379/0

# mongodb://localhost:27017/chat
# mongodb+srv://user:pass@cluster.mongodb.net/chat?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/chat

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---------------------------------------------------------------------------
# OTP / SMS
# Set SMS_PROVIDER=twilio in production and fill TWILIO_* vars below.
# Set SMS_PROVIDER=console for local development (logs OTP to stdout).
# ---------------------------------------------------------------------------
OTP_TTL=5m
OTP_LENGTH=6
SMS_PROVIDER=console          # console (dev) | twilio (production)
# Testing only. When set, this OTP verifies every account. Leave empty in production.
OTP_MASTER=

# ---------------------------------------------------------------------------
# Twilio  https://console.twilio.com
# Required when SMS_PROVIDER=twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx       # Twilio verified sender phone number

# ---------------------------------------------------------------------------
# Cashfree  https://docs.cashfree.com/docs/create-order
# Set APP_BASE_URL to your production URL so notify_url is correct.
# ---------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=      # Separate webhook signing secret (recommended)
CASHFREE_ENV=sandbox          # sandbox | production
PAYMENT_CURRENCY=INR
# id,display_name,duration_days,amount_paise,currency  (semicolon-separated)
PAYMENT_PLANS=monthly,Monthly Premium,30,19900,INR;yearly,Yearly Premium,365,199900,INR
